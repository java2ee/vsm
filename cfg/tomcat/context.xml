
<Context docBase="vsm" path="/vsm" reloadable="true"
	source="org.eclipse.jst.jee.server:vsm">

	<Realm className="org.apache.catalina.realm.MemoryRealm"
		pathname="conf/tomcat-users.xml" />

	<Resource auth="Container" driverClassName="org.h2.Driver"
		maxIdle="30" maxTotal="100" maxWaitMillis="10000" name="jdbc/vsm"
		password="" type="javax.sql.DataSource"
		url="jdbc:h2:${catalina.base}/h2/vsm" username="sa" />

</Context>
